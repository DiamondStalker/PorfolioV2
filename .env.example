# Variables de entorno para el Portfolio Frontend
# Copiar este archivo como .env y llenar con los valores reales

# URL base de la API (backend)
VITE_API_BASE_URL=http://localhost:3001/api

# Configuración de la aplicación
VITE_APP_ENVIRONMENT=development
VITE_APP_NAME=Portfolio

# Configuración de GitHub (opcional - solo para rate limiting)
# NO incluir tokens reales aquí
VITE_GITHUB_USER=DiamondStalker

# Configuración de logging
VITE_LOG_LEVEL=info

# URLs de servicios externos (opcional)
# VITE_CDN_URL=https://cdn.example.com
